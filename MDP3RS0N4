local dirToDelta = {
    [North] = {x=0, y=-1},     [East]  = {x=1, y=0},
    [South] = {x=0, y=1},      [West]  = {x=-1, y=0},
    [NorthEast] = {x=1, y=-1}, [SouthEast] = {x=1, y=1},
    [SouthWest] = {x=-1, y=1}, [NorthWest] = {x=-1, y=-1},
}

local tridentOffsets = {
    [North] = {South, SouthWest, SouthEast},
    [East]  = {West,  NorthWest, SouthWest},
    [South] = {North, NorthEast, NorthWest},
    [West]  = {East,  SouthEast, NorthEast},
}

local function positionsForBackTrident()
    local p = pos()
    if not p then return {} end
    local dir = player:getDirection()
    local t = tridentOffsets[dir]
    if not t then return {} end
    local out = {}
    for _, d in ipairs(t) do
        local off = dirToDelta[d]
        table.insert(out, {x = p.x + off.x, y = p.y + off.y, z = p.z})
    end
    return out
end

local function dropBackTrident()
    flowerSet = updateFlowerSet()

    local points = positionsForBackTrident()
    local step = 120
    for i, dropPos in ipairs(points) do
        schedule(i * step, function()
            local flower = getFlowerFromBackpack()
            if flower then
                g_game.move(flower, dropPos, 1)
            else
            end
        end)
    end
end


