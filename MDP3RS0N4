-- extrair nome
local function extractMacroName(code)
    local name = code:match('macro%s*%([^,]+,%s*"([^"]+)"')
    return name or ("Macro " .. (#storage.macrosMDextra+1))
end

--  REMOVE NOME DO MACRO (ANTI VBOT)
local function sanitizeMacroCode(code)
    code = code:gsub('macro%s*%(%s*(%d+)%s*,%s*".-"%s*,%s*function',
                     'macro(%1, function')
    return code
end

-- controle
local activeMacros = {}

-- macro local (SEM VBot)
local function createLocalMacro(timeout, name, callback)
    local obj = {
        name = name,
        timeout = timeout,
        callback = callback,
        enabled = true,
        event = nil
    }

    local function loop()
        if not obj.enabled then return end

        local ok, err = pcall(callback)
        if not ok then
            print("Erro no macro '" .. (name or "sem nome") .. "': " .. err)
        end

        obj.event = scheduleEvent(loop, timeout)
    end

    loop()

    return obj
end

-- rodar macro
local function runMacro(macroData)
    if macroData.code and macroData.code:len() > 3 and not activeMacros[macroData] then
        
        local env = {}
        setmetatable(env, {__index = _G})

        local createdMacro = nil

        -- intercepta macro()
        env.macro = function(timeout, callback)
            createdMacro = createLocalMacro(timeout, macroData.name, callback)
            return createdMacro
        end

        local fn, err = load(macroData.code, "ingame_editor", "t", env)
        if not fn then
            print("Erro ao carregar macro '" .. (macroData.name or "sem nome") .. "': " .. err)
            return
        end

        local ok, execErr = pcall(fn)
        if not ok then
            print("Erro no macro '" .. (macroData.name or "sem nome") .. "': " .. execErr)
            return
        end

        activeMacros[macroData] = createdMacro
    end
end

-- parar macro
local function stopMacro(macroData)
    local m = activeMacros[macroData]
    if m then
        m.enabled = false
        if m.event then
            removeEvent(m.event)
        end
    end
    activeMacros[macroData] = nil
end

