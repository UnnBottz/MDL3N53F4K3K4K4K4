-- =========================
-- DISTANCIA
-- =========================
function Stairs.accurateDistance(p1, p2)
  if type(p1) == 'userdata' then p1 = p1:getPosition() end
  if type(p2) ~= 'table' then p2 = pos() end
  return math.abs(p1.x-p2.x) + math.abs(p1.y-p2.y)
end

-- =========================
-- POS STRING
-- =========================
function Stairs.postostring(pos)
  return pos.x .. ',' .. pos.y .. ',' .. pos.z
end

-- =========================
-- CHECAR TILE
-- =========================
Stairs.Check = {}

Stairs.checkTile = function(tile)
  if not tile then return false end

  local pos = Stairs.postostring(tile:getPosition())

  if Stairs.Check[pos] ~= nil then
    return Stairs.Check[pos]
  end

  if not tile:getTopUseThing() then
    Stairs.Check[pos] = false
    return false
  end

  for _, x in ipairs(tile:getItems()) do
    if table.find(Stairs.Click, x:getId()) then
      Stairs.Check[pos] = true
      return true
    elseif table.find(Stairs.Exclude, x:getId()) then
      Stairs.Check[pos] = false
      return false
    end
  end

  local cor = g_map.getMinimapColor(tile:getPosition())
  if cor >= 210 and cor <= 213 then
    Stairs.Check[pos] = true
    return true
  end

  Stairs.Check[pos] = false
  return false
end

-- =========================
-- VER SE DA PRA USAR
-- =========================
Stairs.isUsable = function(pos)
  local pPos = player:getPosition()
  local dist = getDistanceBetween(pos, pPos)

  if dist <= 2 then return true end
  if dist > 7 then return false end
  if Stairs.accurateDistance(pPos, pos) > 8 then return false end

  return true
end

-- =========================
-- ACHAR ESCADA
-- =========================
Stairs.checkAll = function()
  local tiles = {}

  for _, tile in ipairs(g_map.getTiles(posz())) do
    if Stairs.checkTile(tile) then
      table.insert(tiles, tile)
    end
  end

  if #tiles == 0 then return nil end

  table.sort(tiles, function(a,b)
    return Stairs.accurateDistance(a:getPosition(), pos()) < Stairs.accurateDistance(b:getPosition(), pos())
  end)

  for _, t in ipairs(tiles) do
    if findPath(pos(), t:getPosition()) then
      return t
    end
  end

  return nil
end

