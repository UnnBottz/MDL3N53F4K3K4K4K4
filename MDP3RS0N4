-- DISTÂNCIA
local function distance(p1, p2)
  p2 = p2 or player:getPosition()
  return math.abs(p1.x - p2.x) + math.abs(p1.y - p2.y)
end

-- USE TILE
local function handleUse(pos)
  local tile = g_map.getTile(pos)
  if tile and tile:getTopUseThing() then
    g_game.use(tile:getTopUseThing())
  end
end

local function handleRope()
  say("skip")
end

local floorChangeSelector = {
  RopeSpots = { Up = handleRope, Down = handleRope },
  Use = { Up = handleUse, Down = handleUse }
}

local function executeClosest(list)
  local best, chosen = 999, nil

  for _, v in ipairs(list) do
    local d = distance(v.pos)
    if d < best then
      best = d
      chosen = v
    end
  end

  if chosen then
    chosen.changer(chosen.pos)
    return true
  end

  return false
end

local function handleFloorChange()
  local range = 1
  local p = player:getPosition()
  local possible = {}

  for _, dir in ipairs({"Down", "Up"}) do
    for changer, data in pairs(FloorChangers) do
      for x = -range, range do
        for y = -range, range do

          local pos = {x = p.x + x, y = p.y + y, z = p.z}
          local tile = g_map.getTile(pos)

          if tile and tile:getTopUseThing() then
            local id = tile:getTopUseThing():getId()

            if table.find(data[dir], id) then
              table.insert(possible, {
                changer = floorChangeSelector[changer][dir],
                pos = pos
              })
            end
          end
        end
      end
    end
  end

  return #possible > 0 and executeClosest(possible) or false
end

