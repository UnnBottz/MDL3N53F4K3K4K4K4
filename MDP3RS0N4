local cavebotMacro = nil
local config = nil

-- ui
local configWidget = UI.Config(leftPanel)
local ui = UI.createWidget("CaveBotPanel",leftPanel)

ui.list = ui.listPanel.list -- shortcut
CaveBot.actionList = ui.list

