-- Função AutoReborn
local function sendResetMessage()
    if config.levelResetSwitch then
        say(storage.resetmd or "!resetar")
    end
end

local function checkResetMessage(text)
    if not config.levelResetSwitch then return end
    if not storage.resetmds then return end
    local msg = storage.resetmds:lower()
    text = text:lower()
    if text:find(msg) then
        -- Pega o número apenas depois de "nivel necessario:"
        local number = text:match("nivel%s*necessario:%s*(%d+)")
        if number then
            number = tonumber(number)
            config.levelResetValue = number
            if SuppliesWindow and SuppliesWindow.levelResetValue then
                SuppliesWindow.levelResetValue:setText(number)
            end
            print("[AutoReborn] Level reset atualizado para " .. number)
        end
    end
end


-- Triggers
schedule(3000, function()
    sendResetMessage()
end)

onTextMessage(function(mode, text)
    checkResetMessage(text)
end)

end)

