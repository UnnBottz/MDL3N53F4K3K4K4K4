local function doFollow()

  if not targetID then return end

  local target = nil

  for _, spec in ipairs(getSpectators()) do
    if spec:getId() == targetID then
      target = spec
      break
    end
  end

  if not target then return end

  local lpos = target:getPosition()
  if not lpos then return end

  local myPos = player:getPosition()

  local params = {
    ignoreNonPathable = true,
    precision = 1,
    ignoreCreatures = true
  }

  local dist = getDistanceBetween(myPos, lpos)
  local path = findPath(myPos, lpos, 40, params)

  if dist > 1 and not path then
    handleFloorChange()
    return
  end

  if dist > 2 then
    autoWalk(lpos, 40, params)
    standTime = now or 0
  end
end

