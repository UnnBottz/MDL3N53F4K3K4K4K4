Stairs.walk = macro(200, function()
  local cfg = storage["MageBomb"]
  if not cfg then return end
  if not safeGet(MageBomboMDWindow, "buttonEscada"):isChecked() then return end
  local key = getKey()
  if not key or key == "" then return end

  local tile = Stairs.checkAll()

  -- NÃO APERTOU TECLA
  if not modules.corelib.g_keyboard.isKeyPressed(key) then
    mark(tile, "red")
    return
  end

  -- APERTOU TECLA
  if not tile then
    player:setText("SEM ESCADA")
    return
  end

  local tilePos = tile:getPosition()
  local dist = getDistanceBetween(pos(), tilePos)

  mark(tile, "green")

  if dist == 0 then
    use(tile:getTopUseThing())
    return
  end

  if dist == 1 then
    autoWalk(tilePos, 1)
    return
  end

  autoWalk(tilePos)
end)

