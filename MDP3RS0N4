local GOOGLE_SHEETS_URL =
"https://docs.google.com/spreadsheets/d/1OvJ7nn5pNjnSKV0Z1-i_O0D7BtBbrhC4-dx-2PSh2es/gviz/tq?tqx=out:json"

local _isAuthorized = false
local _currentMAC = ""

local function getCurrentMAC()

  if not modules.client
  or not modules.client.g_platform
  or not modules.client.g_platform.getMacAddresses then

    print("ERRO: getMacAddresses nao encontrado")
    return ""
  end

  local success, macList = pcall(function()
    return modules.client.g_platform.getMacAddresses()
  end)

  if not success then
    print("ERRO AO PEGAR MAC")
    return ""
  end

  if not macList or #macList == 0 then
    print("NENHUM MAC ENCONTRADO")
    return ""
  end

  print("MAC ENCONTRADO: " .. tostring(macList[1]))

  return macList[1]
end

local function isMACAuthorized(callback)

  local currentMAC = getCurrentMAC()

  if currentMAC == "" then
    callback(false)
    return
  end

  _currentMAC = currentMAC

  print("VERIFICANDO MAC: " .. currentMAC)

  if not modules.corelib or not modules.corelib.HTTP then
    print("HTTP MODULE NAO ENCONTRADO")
    callback(false)
    return
  end

  modules.corelib.HTTP.get(GOOGLE_SHEETS_URL, function(response, error)

    if error then
      print("ERRO HTTP: " .. tostring(error))
      callback(false)
      return
    end

    if not response then
      print("RESPOSTA VAZIA")
      callback(false)
      return
    end

    print("GOOGLE SHEETS CARREGADO")

    local clean = response

    clean = clean:gsub("^%/%*O_o%*%/%s*\n", "")
    clean = clean:gsub("google%.visualization%.Query%.setResponse%(", "")
    clean = clean:gsub("%);$", "")

    if not json or not json.decode then
      print("JSON MODULE NAO ENCONTRADO")
      callback(false)
      return
    end

    local success, data = pcall(function()
      return json.decode(clean)
    end)

    if not success then
      print("ERRO AO DECODIFICAR JSON")
      callback(false)
      return
    end

    if not data
    or not data.table
    or not data.table.rows then

      print("ESTRUTURA INVALIDA")
      callback(false)
      return
    end

    print("TOTAL DE LINHAS: " .. #data.table.rows)

    for i = 1, #data.table.rows do

      local row = data.table.rows[i]

      if row
      and row.c
      and row.c[1]
      and row.c[1].v then

        local mac = tostring(row.c[1].v)

        mac = mac:match("^%s*(.-)%s*$")

        print("MAC PLANILHA: " .. mac)

        if mac:upper() == currentMAC:upper() then

          print("MAC AUTORIZADO")

          callback(true)
          return
        end
      end
    end

    print("MAC NAO AUTORIZADO")

    callback(false)
  end)
end

