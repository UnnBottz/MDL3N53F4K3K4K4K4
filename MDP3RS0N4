-- ====== Helpers ======
local function format_thousand(v)
  if not v then return "0" end
  local s = string.format("%d", math.floor(v))
  local pos = string.len(s) % 3
  if pos == 0 then pos = 3 end
  return string.sub(s, 1, pos) .. string.gsub(string.sub(s, pos+1), "(...)", ".%1")
end

local function expGained() return exp() - startExp end

local function expLeft()
  local level = lvl() + 1
  return math.floor((50*level*level*level)/3 - 100*level*level + (850*level)/3 - 200) - exp()
end

local function niceTimeFormat(v)
  local h = string.format("%02.f", math.floor(v/3600))
  local m = string.format("%02.f", math.floor(v/60 - (h*60)))
  return h .. ":" .. m .. "h"
end

local function sessionTime()
  return niceTimeFormat(math.floor((now - launchTime)/1000))
end

local function expPerHour(calc)
  if #expTable == 0 then return "-" end
  local r = exp() - expTable[1]
  local uptime = math.floor((now - launchTime)/1000)
  if uptime < 900 then r = math.ceil((r/uptime)*3600) else r = math.ceil(r*8) end
  return calc and r or format_thousand(r)
end

local function timeToLevel()
  if expPerHour(true) == 0 or expPerHour() == "-" then return "-" end
  local t = expLeft()/expPerHour(true)
  return niceTimeFormat(math.ceil(t*3600))
end

local function valueInSeconds(t)
  local d = 0
  local st = 0
  if #t > 0 then
    for i, v in ipairs(t) do
      if now - v.t <= 3000 then
        if st == 0 then st = v.t end
        d = d + v.d
      else
        table.remove(t, 1)
      end
    end
  end
  if st == 0 then return 0 end
  return math.ceil(d/((now - st)/1000))
end

