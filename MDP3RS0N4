  if not ok then
    warn("Erro ao criar row UI: " .. tostring(item))
    return nil
  end
  return item
end

function refreshMK()
  if not ui or not ui.content then return end
  for _, child in pairs(ui.content:getChildren()) do child:destroy() end
  for name, count in pairs(killList) do
    local row = safe_load_ui_row(name, count)
    if row then
      pcall(function()
        row.name:setText(name .. ":")
        row.count:setText("x" .. tostring(count))
      end)
    end
  end
end

local patterns = {
  "loot of a (.-):",
  "loot of an (.-):",
  "loot of the (.-):",
  "loot of (.-):",
  "loot: (.-)"
}

local function checkKill(text)
  if not text then return end
  local lower = text:lower()
  if not (lower:find("loot") or lower:find("looted")) then return end

  for _, p in ipairs(patterns) do
    local mob = lower:match(p)
    if mob then
      -- trim e limpeza
      mob = mob:gsub("^%s*(.-)%s*$", "%1")
      mob = mob:gsub("%s*[:%-].*$", "")
      -- display com capital inicial
      local display = mob:gsub("^%l", string.upper)
      killList[display] = (killList[display] or 0) + 1
      storage.killList = killList
      refreshMK()
      return
    end
  end
end

