-- =========================
-- PATH (A*)
-- =========================
local function findPath(startPos, endPos)
  local openList, closedList = {}, {}
  local cameFrom, gScore, fScore = {}, {}, {}

  local function key(p) return p.x..","..p.y..","..p.z end

  local function neighbors(pos)
    local dirs = {
      {x=0,y=-1},{x=-1,y=0},{x=0,y=1},{x=1,y=0},
      {x=-1,y=-1},{x=1,y=-1},{x=-1,y=1},{x=1,y=1}
    }
    local result = {}
    for _, d in ipairs(dirs) do
      local p = {x=pos.x+d.x, y=pos.y+d.y, z=pos.z}
      local tile = g_map.getTile(p)
      if tile and tile:isWalkable() and not isNotOk(tile) then
        table.insert(result, p)
      end
    end
    return result
  end

  local function h(a,b)
    return math.abs(a.x-b.x) + math.abs(a.y-b.y)
  end

  local startK = key(startPos)
  openList[startK] = startPos
  gScore[startK] = 0
  fScore[startK] = h(startPos, endPos)

  while true do
    local current, currentKey, lowest

    for k, pos in pairs(openList) do
      if not lowest or fScore[k] < lowest then
        current, currentKey, lowest = pos, k, fScore[k]
      end
    end

    if not current then break end

    if getDistanceBetween(current, endPos) == 0 then
      local path = {}
      while cameFrom[key(current)] do
        table.insert(path, 1, current)
        current = cameFrom[key(current)]
      end
      return path
    end

    openList[currentKey] = nil
    closedList[currentKey] = true

    for _, n in ipairs(neighbors(current)) do
      local nk = key(n)
      if not closedList[nk] then
        local g = gScore[currentKey] + 1

        if not gScore[nk] or g < gScore[nk] then
          cameFrom[nk] = current
          gScore[nk] = g
          fScore[nk] = g + h(n, endPos)
          openList[nk] = n
        end
      end
    end
  end

  return {}
end

-- =========================
-- MACRO COM DELAY + REPOSICIONAMENTO
-- =========================
local pushMacro

local function updatePushMacro()
  local delayValue = getDelay()

  if pushMacro then pushMacro:setOff() end

  pushMacro = macro(delayValue, function()
    if not storage[name].buttonPush then return end
    if not pushTarget or not targetTile then return end

    local currentPos = pushTarget:getPosition()
    local destPos = targetTile:getPosition()

    if getDistanceBetween(currentPos, destPos) == 0 then return end

    if #pushPath == 0 then
      pushPath = findPath(currentPos, destPos)
      currentPathStep = 1
      if #pushPath == 0 then return end
    end

    local nextStep = pushPath[currentPathStep]
    if not nextStep then return end

    local nextTile = g_map.getTile(nextStep)
    if not nextTile then return end

    --  REPOSICIONAMENTO INTELIGENTE
    local playerPos = player:getPosition()
    local targetPos = pushTarget:getPosition()
    local targetDistance = getDistanceBetween(playerPos, targetPos)

    if targetDistance <= 1 then
      local dx = targetPos.x - nextStep.x
      local dy = targetPos.y - nextStep.y

      local backPos = {
        x = targetPos.x + dx,
        y = targetPos.y + dy,
        z = targetPos.z
      }

      local backTile = g_map.getTile(backPos)

      if backTile and backTile:isWalkable() and not backTile:hasCreature() then
        autoWalk(backPos, true, true)
        return
      end
    end

    -- PUSH NORMAL
    if nextTile:isWalkable() then
      g_game.move(pushTarget, nextStep)

      currentPathStep = currentPathStep + 1
      if currentPathStep > #pushPath then
        pushPath = {}
        currentPathStep = 0
      end
    else
      pushPath = {}
    end
  end)
end

