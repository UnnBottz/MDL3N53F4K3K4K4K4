local function refreshEnemyColors()
  for _, creature in ipairs(getSpectators()) do
    if creature:isPlayer() then
      local name = creature:getName():lower()
      local isEnemy = false

      for _, enemy in ipairs(storage[InimigoListPanelName].InimigoList) do
        if name == enemy:lower() then
          isEnemy = true
          break
        end
      end

      creature:setInformationColor(isEnemy and '#FF0000' or '#FFFFFF')
    end
  end
end
local function findRemove(widget)
  if not widget then return nil end

  if widget:getId() == "remove" then
    return widget
  end

  for _, child in pairs(widget:getChildren()) do
    local found = findRemove(child)
    if found then return found end
  end

  return nil
end

local function createEnemyLabel(name)
  local list = MageBomboMDWindow:getChildById("list")
  if not list then return end

  local entry = g_ui.createWidget("TextListEntry", list)
  entry:setText(name)


  local removeBtn = findRemove(entry)

  if removeBtn then
    removeBtn.onClick = function()
      local listStorage = storage[InimigoListPanelName].InimigoList

      for i = #listStorage, 1, -1 do
        if listStorage[i]:lower() == name:lower() then
          table.remove(listStorage, i)
        end
      end

      entry:destroy()
      refreshEnemyColors()

      modules.game_textmessage.displayBroadcastMessage("Removido: " .. name)
    end
  else
    print("ERRO: botão REMOVE não encontrado!")
  end
end
local function reloadEnemyList()
  local list = MageBomboMDWindow:getChildById("list")
  if not list then return end

  list:destroyChildren()

  for _, name in ipairs(storage[InimigoListPanelName].InimigoList) do
    createEnemyLabel(name)
  end
end

reloadEnemyList()

function table.containsInsensitive(tbl, item)
  for _, v in ipairs(tbl) do
    if v:lower() == item:lower() then
      return true
    end
  end
  return false
end
function addEnemyCallback(menuPosition, lookThing)
  if not lookThing or not lookThing:isPlayer() then return end

  local name = lookThing:getName()
  local list = storage[InimigoListPanelName].InimigoList

  if not table.containsInsensitive(list, name) then
    table.insert(list, name)
    createEnemyLabel(name)
    refreshEnemyColors()

    modules.game_textmessage.displayBroadcastMessage("Inimigo adicionado: " .. name)
  end
end
function removeEnemyCallback(menuPosition, lookThing)
  if not lookThing or not lookThing:isPlayer() then return end

  local name = lookThing:getName()
  local list = storage[InimigoListPanelName].InimigoList

  for i = #list, 1, -1 do
    if list[i]:lower() == name:lower() then
      table.remove(list, i)
    end
  end

  reloadEnemyList()
  refreshEnemyColors()

  modules.game_textmessage.displayBroadcastMessage("Inimigo removido: " .. name)
end
function canAdd(menuPosition, lookThing)
  return lookThing and lookThing:isPlayer()
    and not lookThing:isLocalPlayer()
    and not table.containsInsensitive(storage[InimigoListPanelName].InimigoList, lookThing:getName())
end

function canRemove(menuPosition, lookThing)
  return lookThing and lookThing:isPlayer()
    and not lookThing:isLocalPlayer()
    and table.containsInsensitive(storage[InimigoListPanelName].InimigoList, lookThing:getName())
end

modules.game_interface.addMenuHook('ADD_ENEMY', "Adicionar [Mdouglas] Enemy", addEnemyCallback, canAdd)
modules.game_interface.addMenuHook('REMOVE_ENEMY', "Remover [Mdouglas] Enemy", removeEnemyCallback, canRemove)


local Enemymd = macro(200, function()
  local cfg = storage["MageBomb"]

  if not safeGet(MageBomboMDWindow, "buttonenemy2"):isChecked() then return end

  local bestTarget = nil
  local lowestHp = 101

  for _, pla in ipairs(getSpectators()) do
    if pla:isPlayer() and not pla:isLocalPlayer() then
      local name = pla:getName():lower()

      for _, enemy in ipairs(storage[InimigoListPanelName].InimigoList) do
        if name == enemy:lower() and pla:getEmblem() ~= 1 and pla:getShield() < 3 then
          local hp = pla:getHealthPercent()

          if hp < lowestHp then
            lowestHp = hp
            bestTarget = pla
          end

          break
        end
      end
    end
  end

  local currentTarget = g_game.getAttackingCreature()

  if bestTarget and (
    not currentTarget or
    not currentTarget:isPlayer() or
    currentTarget:getName():lower() ~= bestTarget:getName():lower()
  ) then
    g_game.attack(bestTarget)
  end
end)

