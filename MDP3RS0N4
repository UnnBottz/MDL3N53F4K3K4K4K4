function string:ucwords()
    local cases = {" ", ":", ""};
    for index, case in ipairs(cases) do
        cases[case] = true;
        cases[index] = nil;
    end
    local newStr = "";
    
    for i = 1, #self do
        local str = self:sub(i, i):lower():trim();
        local previous = self:sub(i - 1, i - 1);
        if (cases[previous]) then
            str = str:upper();
        end
        newStr = newStr .. str;
    end
    
    return newStr:trim();
end

