onTextMessage(function(mode, text)
  -- proteção: só processa strings
  if type(text) ~= "string" then return end

  -- dano / heal já existentes
  local val = 0
  pcall(function() val = getFirstNumberInText(text) end)
  if mode == 21 and val and val > 0 then
    totalDmg = totalDmg + val
    table.insert(dmgTable, {d = val, t = now})
    if val > storage.bestHit then storage.bestHit = val end
  end
  if mode == 23 and val and val > 0 then
    totalHeal = totalHeal + val
    table.insert(healTable, {d = val, t = now})
    if val > storage.bestHeal then storage.bestHeal = val end
  end

  -- distribuição de dano (proteção)
  if text:find("You lose") then
    local ok, data = pcall(function() return regexMatch(text, regex)[1] end)
    if ok and data then
      local monster = data[4]
      local damage = tonumber(data[2]) or 0
      table.insert(dmgDistribution, {v = damage, m = monster, t = now})
    end
  end

  -- Checa kills
  pcall(function() checkKill(text) end)
end)

