function antiPush()
  if gpAntiPushDrop:isOff() then return end

  local tile = g_map.getTile(pos())
  if not tile then return end

  -- se já tem muita coisa no tile, não mexe
  if tile:getThingCount() >= maxStackedItems then return end

  -- verifica se já existe algum item anti-push no chão
  for _, thing in pairs(tile:getThings()) do
    if thing:isItem() then
      for _, id in ipairs(dropItems) do
        if thing:getId() == id then
          return -- já está protegido
        end
      end
    end
  end

  -- dropa apenas UM item
  for _, id in ipairs(dropItems) do
    local item = findItem(id)
    if item then
      g_game.move(item, pos(), 1)
      return
    end
  end
end

